         end
 
         ctrl_fsm_ns = DBG_FLUSH;
diff --git a/rtl/cv32e40p_core.sv b/rtl/cv32e40p_core.sv
index 4275cf9..9eab7a5 100644
--- a/rtl/cv32e40p_core.sv
