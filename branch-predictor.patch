  ) (
    // Clock and Reset
    input logic clk_i,
@@ -160,6 +163,7 @@ module cv32e40p_core
   logic               branch_in_ex;
   logic               branch_decision;
   logic        [ 1:0] ctrl_transfer_insn_in_dec;
+  logic        [ 1:0] ctrl_transfer_insn_in_id;
 
   logic               ctrl_busy;
   logic               if_busy;
@@ -167,6 +171,28 @@ module cv32e40p_core
 
   logic        [31:0] pc_ex;  // PC of last executed branch or cv.elw
 
+  // Branch predictor signals
+  logic        bht_predict_taken;   // BHT direction prediction (registered, 1-cycle read)
+  logic        btb_hit;             // BTB hit (registered, 1-cycle read)
+  logic [31:0] btb_target;          // BTB target (registered, 1-cycle read)
+  logic        pred_taken;          // predict taken = EN && btb_hit && bht_taken
+  logic        pred_req;            // prediction redirect request to IF stage
+  logic        predicted_taken_ex;  // metadata: prediction for the branch in EX
+  logic [31:0] predicted_target_ex; // metadata: predicted target for branch in EX
+  logic        is_compressed_ex;    // metadata: EX branch is compressed
+  logic [31:0] fall_through;        // fall-through target = pc_ex + (2|4)
+  logic        branch_mispredict;   // predicted taken but resolved not-taken
+  logic        branch_retired;      // a conditional branch is retiring in EX
+  logic        bht_update_valid;    // BHT update enable
+  logic        btb_write_valid;     // BTB write enable
+  logic [31:0] next_pc_id;          // PC of the instruction entering ID next cycle
+
+  // Branch predictor statistics (exposed for simulation via hierarchical ref)
+  logic [31:0] bp_branch_total;   // total retired conditional branches
+  logic [31:0] bp_pred_taken;     // number of taken predictions made
+  logic [31:0] bp_mispredict;     // number of mispredictions
+  logic [31:0] bp_correct;        // number of correct predictions
+
   // ALU Control
   logic               alu_en_ex;
   alu_opcode_e        alu_operator_ex;
@@ -379,6 +405,111 @@ module cv32e40p_core
   logic clk;
   logic fetch_enable;
 
+  //////////////////////////////////////////////////////////////////////////////
+  // Branch predictor: BHT + BTB integration
+  //
+  // Iteration 1: the BTB/BHT read ports are SYNCHRONOUS (1-cycle read latency),
+  // so they are indexed by the PC of the instruction that will be in ID NEXT
+  // cycle. When the ID stage is moving on (id_valid), that is pc_if; when it
+  // is stalled/bubbled, the current ID instruction stays put, so it is pc_id.
+  // The prediction data therefore lands exactly in the cycle the instruction
+  // is in ID (reusing the same ID-stage redirect timing), and the branch is
+  // NOT dropped: it still flows to EX where the prediction is verified.
+  //////////////////////////////////////////////////////////////////////////////
+
+  // BTB stores {valid, tag, target} indexed by PC[INDEX_W:1]
+  cv32e40p_btb #(
+      .ENTRIES       (BTB_ENTRIES),
+      .BR_PREDICT_EN (BR_PREDICT_EN)
+  ) btb_i (
+      .clk            (clk_i),
+      .rst_n          (rst_ni),
+      .flush_bp_i     (flush_bp),
+      .debug_mode_i   (debug_mode),
+      .read_pc_i      (next_pc_id),
+      .btb_hit_o      (btb_hit),
+      .btb_target_o   (btb_target),
+      .write_valid_i  (btb_write_valid),
+      .write_pc_i     (pc_ex),
+      .write_target_i (jump_target_ex)
+  );
+
+  // BHT: 2-bit saturating-counter direction predictor indexed by PC[INDEX_W:1]
+  cv32e40p_bht #(
+      .DEPTH         (BHT_DEPTH),
+      .BR_PREDICT_EN (BR_PREDICT_EN)
+  ) bht_i (
+      .clk            (clk_i),
+      .rst_n          (rst_ni),
+      .flush_bp_i     (flush_bp),
+      .debug_mode_i   (debug_mode),
+      .read_pc_i      (next_pc_id),
+      .predict_taken_o(bht_predict_taken),
+      .update_valid_i (bht_update_valid),
+      .update_pc_i    (pc_ex),
+      .update_taken_i (branch_decision)
+  );
+
+  // Predict taken only on a trusted BTB hit (BTB hit AND BHT direction taken).
+  assign pred_taken = BR_PREDICT_EN && btb_hit && bht_predict_taken;
+
+  // PC of the instruction that will be in ID next cycle: pc_if when the ID
+  // stage is moving on, otherwise the current ID PC (stall/bubble). This is
+  // the synchronous-read address for the BTB/BHT (1-cycle read latency).
+  assign next_pc_id = id_valid ? pc_if : pc_id;
+
+  // Prediction redirect: branch in ID and moving to EX (id_valid), it is a
+  // conditional branch, and there is no higher-priority controller redirect.
+  // instr_valid_id gates out stale pc_id/ctrl_transfer values when ID is empty.
+  // Gate on ctrl_transfer_insn_in_id (deassert_we-gated) so pred_req uses the
+  // same qualifier that later becomes branch_in_ex_o (pred_req gating fix).
+  assign pred_req = pred_taken && instr_valid_id && id_valid &&
+                    (ctrl_transfer_insn_in_id == BRANCH_COND) && ~pc_set;
+
+  // Fall-through target for mispredict recovery (RVC aware: +2 if compressed).
