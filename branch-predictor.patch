             // the current LW or SW have been blocked by the PMP
@@ -1156,8 +1176,10 @@ module cv32e40p_controller import cv32e40p_pkg::*;
 
         if (branch_taken_ex_i) begin
           // there is a branch in the EX stage that is taken
-          pc_mux_o = PC_BRANCH;
-          pc_set_o = 1'b1;
+          if (~predicted_taken_ex_i) begin
+            pc_mux_o = PC_BRANCH;
+            pc_set_o = 1'b1;
