diff --git a/rtl/cv32e40p_bht.sv b/rtl/cv32e40p_bht.sv
new file mode 100644
index 0000000..22f99e5
--- /dev/null
+++ b/rtl/cv32e40p_bht.sv
@@ -0,0 +1,140 @@
+////////////////////////////////////////////////////////////////////////////////
+// Engineer:       author (synchronous-read BHT)                             //
+//                                                                            //
+// Design Name:    cv32e40p_bht                                               //
+// Project Name:   CV32E40P branch predictor (dynamic, disableable)           //
+// Language:       SystemVerilog                                              //
+//                                                                            //
+// Description:    2-bit saturating-counter branch direction predictor        //
+//                 (BHT). One counter per entry; indexed by low bits of PC.   //
+//                                                                            //
+//                 Iteration 1: the PREDICTION read is now synchronous        //
+//                 (registered output, 1-cycle read latency), matching the    //
+//                 BTB so both are driven by pc_if and land in the ID cycle.  //
+//                 The counter array itself stays an async-reset DFF array    //
+//                 (reset value = weakly not-taken must be preserved; a BRAM  //
+//                 cannot clear its content). The update path is a            //
+//                 read-modify-write on the DFF array (unchanged semantics).  //
+//                                                                            //
+//                 State encoding:                                            //
+//                   00 = strongly not-taken (SNT)                            //
+//                   01 = weakly   not-taken (WNT)  <- reset value            //
+//                   10 = weakly   taken     (WT)                             //
+//                   11 = strongly taken     (ST)                             //
+//                 Prediction = counter[1] (0 for SNT/WNT, 1 for WT/ST).      //
+//                                                                            //
+//                 BR_PREDICT_EN = 0 => predict_taken_o hardwired to 0 and    //
+//                 the state is frozen (update ignored).                      //
+//                                                                            //
+//                 Iteration 2 (robustness):                                  //
+//                   - per-entry valid bit: reset/flush clears valid, and only //
+//                     a valid entry may predict taken (cold-start taken loads //
+//                     no longer predict taken before first training).         //
+//                   - flush_bp_i clears valid (fence.i / exception / context  //
+//                     switch).                                               //
+//                   - debug_mode_i disables training (update), keeps reads.  //
+//                                                                            //
+//                 Clock domain : clk (same as core).                         //
+//                 Reset        : rst_n active-low, asynchronous.             //
+//                                                                            //
+////////////////////////////////////////////////////////////////////////////////
+
+module cv32e40p_bht #(
+    parameter int unsigned DEPTH         = 128,  // number of counters (64/128/256 supported)
+    parameter bit          BR_PREDICT_EN = 1'b1  // 1 = predictor active, 0 = always predict not-taken
+) (
+    input  logic clk,    // Clock
+    input  logic rst_n,  // Asynchronous reset, active low
+
+    // Control gating (robustness):
+    //   flush_bp_i   : clear all valid bits (fence.i / exception / context switch).
+    //   debug_mode_i : in debug mode no training happens (update disabled); the
+    //                  read/predict path is left untouched.
+    input  logic        flush_bp_i,
+    input  logic        debug_mode_i,
+
+    // BHT is indexed ONLY by PC[INDEX_W:1] (no tag, by design). Therefore the
+    // high PC bits (above INDEX_W) are intentionally unused, and bit[0] is
+    // intentionally ignored because every PC is halfword-aligned (bit0 == 0).
+    /* verilator lint_off UNUSEDSIGNAL */
+    // Read port (synchronous): predict direction for read_pc_i (1 cycle ago)
+    input  logic [31:0] read_pc_i,       // PC to predict for (byte address, halfword-aligned)
+    output logic        predict_taken_o, // 1 = predict taken, 0 = predict not-taken
+
+    // Update port (synchronous): train the counter with the resolved direction
+    input  logic        update_valid_i,  // 1 = update_taken_i is valid this cycle
+    input  logic [31:0] update_pc_i,     // PC of the branch being resolved
+    input  logic        update_taken_i   // resolved direction: 1 = taken, 0 = not-taken
+    /* verilator lint_on UNUSEDSIGNAL */
+);
+
+  localparam int unsigned INDEX_W = $clog2(DEPTH);
+
+  // Index = PC[INDEX_W:1]; bit 0 ignored (always 0 for halfword-aligned code).
+  // Halfword granularity so RVC (16-bit) branches at the same word do not alias.
+  logic [INDEX_W-1:0] read_index;
+  logic [INDEX_W-1:0] update_index;
+
+  // 2-bit saturating counter table (packed so whole table can be reset at once),
+  // plus a per-entry valid bit: only a trained entry may predict taken.
+  logic [DEPTH-1:0][1:0] counter_q;
+  logic [DEPTH-1:0]      valid_q;
+  logic [1:0]            counter_n;
+
+  // Registered prediction output (1-cycle synchronous read). Only the MSB of
+  // the counter (the "taken" bit) is needed for the prediction, so it is
+  // registered directly; the valid bit is registered alongside it.
+  logic                  rcounter_q;
+  logic                  rvalid_q;
+
+  assign read_index   = read_pc_i[INDEX_W:1];
+  assign update_index = update_pc_i[INDEX_W:1];
+
+  // Effective update enable: gated by BR_PREDICT_EN (EN=0 constant-folds the
+  // whole table away, since predict_taken_o is also forced to 0 below) and by
+  // ~debug_mode_i (no training in debug mode).
+  logic update_en;
+  assign update_en = BR_PREDICT_EN && update_valid_i && ~debug_mode_i;
+
+  // Next-state of the entry being updated (saturating up/down).
+  always_comb begin
+    if (update_taken_i) begin
+      counter_n = (counter_q[update_index] == 2'b11) ? 2'b11 :
+                  counter_q[update_index] + 2'b01;
+    end else begin
+      counter_n = (counter_q[update_index] == 2'b00) ? 2'b00 :
+                  counter_q[update_index] - 2'b01;
+    end
+  end
+
+  // Synchronous read: register the predicted direction + valid bit (1-cycle latency).
+  always_ff @(posedge clk, negedge rst_n) begin
+    if (rst_n == 1'b0) begin
+      rcounter_q <= 1'b0;
+      rvalid_q   <= 1'b0;
+    end else begin
+      rcounter_q <= counter_q[read_index][1];
+      rvalid_q   <= valid_q[read_index];
+    end
+  end
+
+  // Prediction: MSB of the 2-bit counter, qualified by the valid bit. Hardwired
+  // to 0 when disabled.
+  assign predict_taken_o = BR_PREDICT_EN && rvalid_q && rcounter_q;
+
+  // Synchronous update + asynchronous reset (reset value = weakly not-taken).
+  // flush_bp_i clears only the valid bits (counter left stale but inert, since
+  // an invalid entry never predicts taken). First update sets the valid bit.
+  always_ff @(posedge clk, negedge rst_n) begin : BHT_STATE
+    if (rst_n == 1'b0) begin
+      counter_q <= {DEPTH{2'b01}};
+      valid_q   <= '0;
+    end else if (flush_bp_i) begin
+      valid_q   <= '0;
+    end else if (update_en) begin
+      counter_q[update_index] <= counter_n;
+      valid_q[update_index]   <= 1'b1;
+    end
+  end
+
+endmodule
diff --git a/rtl/cv32e40p_btb.sv b/rtl/cv32e40p_btb.sv
new file mode 100644
index 0000000..d5f0c5c
--- /dev/null
+++ b/rtl/cv32e40p_btb.sv
@@ -0,0 +1,160 @@
+////////////////////////////////////////////////////////////////////////////////
+// Engineer:       author (synchronous-read SRAM/BRAM BTB)                    //
+//                                                                            //
+// Design Name:    cv32e40p_btb                                               //
+// Project Name:   CV32E40P branch predictor (dynamic, disableable)           //
+// Language:       SystemVerilog                                              //
+//                                                                            //
+// Description:    Direct-mapped + tagged Branch Target Buffer (BTB).         //
+//                 Each entry = {valid, tag, target}.                         //
+//                                                                            //
+//                 Iteration 1: the read port is now a SYNCHRONOUS read       //
+//                 (registered output, 1-cycle read latency) so that the tag/ //
+//                 target array is inferred as a SRAM/BRAM macro instead of a  //
+//                 per-bit 128:1 read mux (the area explosion). The `valid`   //
+//                 bit stays a separate async-reset DFF array (a BRAM cannot   //
+//                 clear its content on reset), so the reset semantics         //
+//                 (no hit after reset) are unchanged.                        //
+//                                                                            //
+//                 Index = PC[INDEX_W:1], Tag = PC[31:INDEX_W+1] (bit 0       //
+//                 ignored, always 0 for halfword-aligned code).              //
+//                                                                            //
+//                 Hit  = valid && (tag_q == tag of read PC).                 //
+//                                                                            //
+//                 Alias semantics:                                            //
+//                   - Two PCs with the same index but different tags: the    //
+//                     later write evicts the earlier (direct-mapped conflict).
+//                   - Two PCs that share index AND tag differ only in bit[0], //
+//                     i.e. they are byte addresses of the same halfword, so  //
+//                     they can never both be distinct branch instructions.   //
+//                                                                            //
+//                 Read timing (1-cycle latency): btb_hit_o / btb_target_o    //
+//                 reflect read_pc_i as sampled at the PREVIOUS clock edge.   //
+//                 The core therefore drives read_pc_i with pc_if (the fetch  //
+//                 PC, one cycle ahead of pc_id) so the prediction lands in   //
+//                 the ID cycle.                                              //
+//                                                                            //
+//                 Robustness:                                                //
+//                   - BR_PREDICT_EN parameter: EN=0 forces btb_hit_o to 0    //
+//                     and disables write_en, so an EN=0 build constant-folds //
+//                     the whole tag+target storage away.                     //
+//                   - flush_bp_i clears all valid bits (fence.i / exception  //
+//                     / context switch), leaving tag/target stale but inert. //
+//                   - debug_mode_i disables training (write), keeps reads.   //
+//                                                                            //
+//                 Clock domain : clk (same as core).                         //
+//                 Reset        : rst_n active-low, asynchronous (clears valid).
+//                                                                            //
+////////////////////////////////////////////////////////////////////////////////
+
+module cv32e40p_btb #(
+    parameter int unsigned ENTRIES       = 32,   // number of BTB entries
+    parameter bit          BR_PREDICT_EN = 1'b1  // 1 = predictor active, 0 = fully bypassed
+) (
+    input  logic clk,    // Clock
+    input  logic rst_n,  // Asynchronous reset, active low
+
+    // Control gating (robustness):
+    //   flush_bp_i   : clear all valid bits (fence.i / exception / context switch).
+    //   debug_mode_i : in debug mode no training happens (write disabled); the
+    //                  read/predict path is left untouched.
+    input  logic        flush_bp_i,
+    input  logic        debug_mode_i,
+
+    // bit[0] of the PC is intentionally ignored: every PC is halfword-aligned
+    // (bit0 == 0). All other bits are consumed (index = [INDEX_W:1], tag =
+    // [31:INDEX_W+1]).
+    /* verilator lint_off UNUSEDSIGNAL */
+    // Read port (synchronous: output reflects read_pc_i from 1 cycle ago)
+    input  logic [31:0] read_pc_i,    // PC to look up (byte address, halfword-aligned)
+    output logic        btb_hit_o,    // 1 = entry valid && tag matches
+    output logic [31:0] btb_target_o, // predicted target (valid only when btb_hit_o)
+
+    // Write port (synchronous)
+    input  logic        write_valid_i, // 1 = write a new entry this cycle
+    input  logic [31:0] write_pc_i,    // PC of the branch being recorded
+    input  logic [31:0] write_target_i // resolved target to store
+    /* verilator lint_on UNUSEDSIGNAL */
+);
+
+  localparam int unsigned INDEX_W = $clog2(ENTRIES);
+  localparam int unsigned TAG_W   = 32 - INDEX_W - 1;
+  localparam int unsigned DATA_W  = TAG_W + 32;  // packed {tag, target}
+
+  logic [INDEX_W-1:0] read_index;
+  logic [TAG_W-1:0]   read_tag;
+
+  logic [INDEX_W-1:0] write_index;
+  logic [TAG_W-1:0]   write_tag;
+
+  // Storage:
+  //   valid_q : separate async-reset DFF array (a BRAM cannot be reset).
+  //   mem_q   : synchronous-read tag+target array -> inferred as SRAM/BRAM.
+  //             Declared UNPACKED so sv2v keeps it a memory (a packed 2D array
+  //             would be flattened to a packed vector and expanded to a mux).
+  logic [ENTRIES-1:0]   valid_q;
+  logic [DATA_W-1:0]    mem_q [ENTRIES];  // mem_q[i] = {tag, target}
+
+  // Registered read outputs (1-cycle read latency).
+  logic        rvalid_q;
+  logic [TAG_W-1:0]   rtag_q;
+  logic [DATA_W-1:0]  rdata_q;
+
+  assign read_index  = read_pc_i[INDEX_W:1];
+  assign read_tag    = read_pc_i[31:INDEX_W+1];
+
+  assign write_index = write_pc_i[INDEX_W:1];
+  assign write_tag   = write_pc_i[31:INDEX_W+1];
+
+  // Effective write enable: gated by BR_PREDICT_EN (so an EN=0 build can
+  // constant-fold the whole storage away) and by ~debug_mode_i (no training in
+  // debug mode). When BR_PREDICT_EN==0, write_en is a compile-time 0, mem_q /
+  // valid_q are never written, and because btb_hit_o is also forced to 0 below,
+  // the entire storage becomes dead logic and is eliminated by synthesis.
+  logic write_en;
+  assign write_en = BR_PREDICT_EN && write_valid_i && ~debug_mode_i;
+
+  // Synchronous read: register the tag and the tag+target data. rdata_q is
+  // deliberately NOT async-reset (keeps it a clean sync-read for BRAM mapping);
+  // rvalid_q gates the hit so no spurious hit is observable after reset.
+  always_ff @(posedge clk) begin
+    rtag_q  <= read_tag;
+    rdata_q <= mem_q[read_index];
+  end
+
+  always_ff @(posedge clk, negedge rst_n) begin
+    if (rst_n == 1'b0) begin
+      rvalid_q <= 1'b0;
+    end else begin
+      rvalid_q <= valid_q[read_index];
+    end
+  end
+
+  // Hit = registered valid && stored tag == registered read tag. Forced to 0
+  // when the predictor is disabled so the storage can be constant-folded away.
+  // btb_target_o is also forced to 0 at EN=0 so the tag+target read path has no
+  // live output and mem_q / valid_q / the read registers all become dead logic
+  // that synthesis eliminates (this disables BTB storage at EN=0).
+  assign btb_hit_o    = BR_PREDICT_EN && rvalid_q && (rdata_q[DATA_W-1:32] == rtag_q);
+  assign btb_target_o = BR_PREDICT_EN ? rdata_q[31:0] : 32'd0;
+
+  // Synchronous write: mem_q has a CLEAN sync-write port (no async reset on the
+  // enable) so memory_libmap can map it to a block RAM; valid_q carries the
+  // async reset so the "no hit after reset" semantics are unchanged.
+  always_ff @(posedge clk) begin
+    if (write_en) begin
+      mem_q[write_index] <= {write_tag, write_target_i};
+    end
+  end
+
+  always_ff @(posedge clk, negedge rst_n) begin : BTB_STATE
+    if (rst_n == 1'b0) begin
+      valid_q <= '0;
+    end else if (flush_bp_i) begin
+      valid_q <= '0;
+    end else if (write_en) begin
+      valid_q[write_index] <= 1'b1;
+    end
+  end
+
+endmodule
